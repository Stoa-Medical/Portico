# =============================================================================
# Portico Web App — Environment Variables
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local
# =============================================================================

# --- Authentication & Database (Supabase) ------------------------------------
# Get these from https://supabase.com/dashboard → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Database (Supabase Postgres via Supavisor pooler) -----------------------
# Transaction-mode pooler connection string from Supabase dashboard → Projects → Connect
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# --- Medplum (FHIR R4 clinical data) ----------------------------------------
# https://app.medplum.com → Project Admin → Client Applications
MEDPLUM_BASE_URL=https://api.medplum.com
MEDPLUM_CLIENT_ID=
MEDPLUM_CLIENT_SECRET=

# --- Rust Engine (gRPC) ------------------------------------------------------
# Only needed if running the engine locally (server/docker-compose.yml)
ENGINE_GRPC_URL=localhost:50051

# --- Cron Jobs ---------------------------------------------------------------
# Shared secret to authenticate Vercel Cron requests
CRON_SECRET=
